;;; schematra.egg -*- scheme -*-

((synopsis
  "Schematra is a minimalistic web server built on top of spiffy")
 (author "Rolando Abarca")
 (license "BSD")
 (category web)
 (dependencies spiffy
               base64
               simple-sha1
               srfi-1
               srfi-13
               srfi-18
               srfi-69
               chiccup
               srfi-180
               multipart-form-data
               logger)
 (component-options
  (csc-options "-O3" "-d0"))
 (components (extension schematra.utils)
	     (extension schematra
			(component-dependencies schematra.utils))
	     (extension schematra.ws.internal
			(component-dependencies schematra schematra.utils))
	     (extension schematra.ws
			(component-dependencies schematra.ws.internal))
	     (extension schematra.body-parser
			(component-dependencies schematra))
	     (extension schematra.test
			(component-dependencies schematra))))
